{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "6c1d515a-a2b6-44c7-8f28-a39bc5294f74"
  },
  "newProjectRoot": "projects",
  "projects": {
    "banca-web": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/banca-web",
      "sourceRoot": "projects/banca-web/src",
      "prefix": "bw",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/banca-web/src/main.ts",
            "tsConfig": "projects/banca-web/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/banca-web/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/assets",
                "output": "img"
              }
            ],
            "styles": [
              "projects/banca-web/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "real": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/banca-web/src/entorno.ts",
                  "with": "projects/banca-web/src/entorno.real.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "banca-web:build:production"
            },
            "development": {
              "buildTarget": "banca-web:build:development"
            },
            "real": {
              "buildTarget": "banca-web:build:real"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "bq",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
